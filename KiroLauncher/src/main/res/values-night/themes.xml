<resources>
    <style name="AppTheme.Kiro" parent="Theme.Material3.Dark.NoActionBar">
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowContentOverlay">@null</item>
    </style>
    <style name="AppTheme.SplashScreen" parent="@style/Theme.SplashScreen">
        <item name="postSplashScreenTheme">@style/AppTheme.Kiro</item>
        <item name="windowSplashScreenBackground">@color/kiro_splash_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_launcher</item>
        <item name="windowSplashScreenAnimationDuration">200</item>
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowContentOverlay">@null</item>
    </style>
</resources>
